{
  "name": "trufit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo.mjs",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs",
    "seo": "node scripts/generate-seo.mjs",
    "test:analytics": "node --test src/analytics/core.test.mjs",
    "test:portal": "node --test src/portal/data.test.mjs",
    "test": "npm run test:analytics && npm run test:portal && npm run test:team && npm run test:coaching && npm run test:blog && npm run test:calories",
    "test:team": "node --test src/team/store.test.mjs src/workspace/coaches.test.mjs",
    "test:coaching": "node --test src/components/coaches/reviewData.test.mjs",
    "test:blog": "node --test src/content/blog.test.mjs src/blog/store.test.mjs src/blog/images.test.mjs src/blog/richText.test.mjs",
    "test:calories": "node --test src/calories/core.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "framer-motion": "^12.23.12",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-international-phone": "^4.6.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.0.4"
  }
}
